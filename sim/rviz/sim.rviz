# Simulator layout (teleop layout + simulator ground truth, no camera): live map in odom, obstacles, collision-monitor zones, status. Hand-written rviz2 (Humble) layout.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Color: 160; 160; 164
      Alpha: 0.5
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.5
      Frames:
        All Enabled: false
        base_footprint:
          Value: true
        mid360_imu:
          Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Live map
      Enabled: true
      Topic:
        Value: /mapping/map_cloud
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 150; 150; 150
      Alpha: 0.6
      Decay Time: 0
      Queue Size: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Obstacles
      Enabled: true
      Topic:
        Value: /perception/obstacles
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.05
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Autocompute Value Bounds: true
      Alpha: 1
      Decay Time: 0
    - Class: rviz_default_plugins/Polygon
      Name: Stop zone
      Enabled: true
      Topic:
        Value: /stop_zone
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 0; 0
      Alpha: 1
    - Class: rviz_default_plugins/Polygon
      Name: Approach zone
      Enabled: true
      Topic:
        Value: /approach_zone
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 165; 0
      Alpha: 1
    - Class: rviz_default_plugins/Marker
      Name: Status
      Enabled: true
      Topic:
        Value: /g1/status_marker
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces: {}
    - Class: rviz_default_plugins/MarkerArray
      Name: Sim truth (obstacles)
      Enabled: true
      Topic:
        Value: /sim/scene
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces: {}
    - Class: rviz_default_plugins/Odometry
      Name: Sim truth (robot)
      Enabled: true
      Topic:
        Value: /sim/ground_truth
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 1
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 0; 220; 80
        Alpha: 1
        Shaft Length: 0.6
        Shaft Radius: 0.04
        Head Length: 0.15
        Head Radius: 0.08
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Odometry
      Name: FAST-LIO odometry
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 1
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 255; 25; 0
        Alpha: 1
        Shaft Length: 0.5
        Shaft Radius: 0.03
        Head Length: 0.12
        Head Radius: 0.06
      Covariance:
        Value: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_footprint
      Distance: 8
      Pitch: 0.8
      Yaw: 3.14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
    Saved: ~
Window Geometry:
  Width: 1280
  Height: 800
  Displays:
    collapsed: false
  Views:
    collapsed: true
